# Copy to .env and fill in real values. Never commit .env.
# On Windows, run `python scripts/protect_env.py` afterwards to encrypt the secrets in place.

# Core
SECRET_KEY=change-this-to-a-random-secret
# Encrypts payment details in the database. Back it up: losing it makes them unreadable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-fernet-key
# Leave DATABASE_URL unset to use SQLite (instance/splitmate.db). See POSTGRES_SETUP.md.
DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/splitmate
# Set to true once the site is served over HTTPS
SECURE_COOKIES=false
RATELIMIT_ENABLED=true

# Email (Gmail SMTP with an app password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_DEFAULT_SENDER=your-email@gmail.com
MAIL_PASSWORD=your-16-character-gmail-app-password-without-spaces
ADMIN_EMAILS=admin@example.com

# Auth timings
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_EXPIRY_MINUTES=30
ACTIVITY_UPDATE_INTERVAL_MINUTES=5

# Inactive-user reminder emails
INACTIVITY_REMINDER_DAYS=30
INACTIVITY_EMAIL_COOLDOWN_DAYS=14
INACTIVITY_EMAILS_ENABLED=true
INACTIVITY_EMAIL_HOUR_UTC=14

# Mobile API
MOBILE_TOKEN_EXPIRY_DAYS=30
MOBILE_API_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
GROUP_INVITE_EXPIRY_DAYS=7

# Display currency for the whole app
STRIPE_CURRENCY=cad
# Splitmate Pro through Stripe Checkout (use test keys locally). Prices are in cents.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRO_PRICE_MONTHLY_CENTS=299
PRO_PRICE_YEARLY_CENTS=2499

# Receipt scanning (Google Gemini). Leave empty to disable scanning.
GEMINI_API_KEY=your-gemini-api-key
RECEIPT_SCAN_MODEL=gemini-3.6-flash

# Grocery price comparison: trimcart (real weekly prices) or demo (sample prices, testing only).
# Items not in the weekly data are looked up online with Gemini + Google Search when GEMINI_API_KEY is set.
GROCERY_PRICE_SOURCE=trimcart
GROCERY_PRICE_MODEL=gemini-3.6-flash
