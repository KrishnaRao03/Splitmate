{
  "expo": {
    "name": "Splitmate",
    "slug": "splimate",
    "scheme": "splitmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.splitmate.mobile"
    },
    "android": {
      "package": "com.splitmate.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f4f7f"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      "./plugins/withCleartextTraffic"
    ],
    "extra": {
      "apiBaseUrl": "",
      "eas": {
        "projectId": "dc469888-57ee-404d-97d8-689e3d8b83c4"
      }
    },
    "owner": "rk011s-team"
  }
}
